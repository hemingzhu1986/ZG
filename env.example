# ── 必填 ──────────────────────────────────────────
TELEGRAM_BOT_TOKEN=          # 在 @BotFather 创建机器人得到；机器人必须是频道管理员
TELEGRAM_CHAT_ID=            # 主频道，如 -1001234567890

# ── 强烈建议 ──────────────────────────────────────
ADMIN_CHAT_ID=               # 你和机器人的私聊 ID：接收运行报告、故障告警、/add 投稿
ADMIN_USER_IDS=              # 允许用 /add 投稿的 Telegram 用户 ID，逗号分隔
DRAMA_CHAT_ID=               # AI 短剧选题发到哪（建议单独的私有群/频道）；不填则发给 ADMIN_CHAT_ID

# ── 可选：大模型（免费档即可；不配置也能运行，只是标题简介和选题卡质量下降）──
LLM_PROVIDER=none            # none | gemini | openai（openai = 任何 OpenAI 兼容接口）
LLM_API_KEY=
LLM_MODEL=                   # 填服务商控制台里标注“免费”的模型名，不要照抄旧文档
LLM_BASE_URL=                # 仅 openai 兼容接口需要，如 https://api.groq.com/openai/v1

# ── 可选：数据源 ──────────────────────────────────
TMDB_API_KEY=                # 免费申请；不填则不发影视榜
RSSHUB_BASE=                 # 备用源用的 RSSHub 地址，默认公共实例 https://rsshub.app（不稳定，建议自建）

# Reddit 在云服务器上没有免费通道；填了才启用 Reddit 来源（第三方托管接口，有免费档，额度以其官网为准）
CRAWLORA_API_KEY=
# 可选：通用第三方抓取接口（Apify），按用量计费、有免费月度额度；用于补小红书/TikTok 等
APIFY_TOKEN=

# 免费机器翻译兜底（没有大模型或大模型漏译时用）：填任意一个有效邮箱，MyMemory 每天额度从 5000 字提到 5 万字，无需注册
MYMEMORY_EMAIL=
